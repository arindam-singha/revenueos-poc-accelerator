# Select the real local model or explicitly opt into the non-AI demo fixture.
AGENT_MODE=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_NUM_PREDICT=2048
OLLAMA_RETRY_NUM_PREDICT=3072

# CRM webhook and independent SLA monitor
CRM_WEBHOOK_TOKEN=replace-with-a-long-random-secret
CRM_WEBHOOK_ALLOW_ANONYMOUS=false
REVENUEOS_DATABASE_PATH=data/revenueos.db
SLA_POLL_SECONDS=60
# Optional comma-separated US business-calendar holidays (YYYY-MM-DD)
SLA_HOLIDAYS=2026-11-26,2026-12-25
# Optional Slack Incoming Webhook; console escalation is always enabled
SLACK_WEBHOOK_URL=
